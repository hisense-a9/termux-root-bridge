#!/data/data/com.termux/files/usr/bin/bash
# androidsu <befehl> - fragt echten Android-Root über die Root-Bridge an.
# Läuft aus der Ubuntu-Session (proot-distro) heraus, schreibt eine Anfrage
# fuer den root-bridge-watch.sh außerhalb von proot und wartet auf Antwort.

BRIDGE_DIR="/data/data/com.termux/files/home/.rootbridge"
mkdir -p "$BRIDGE_DIR"

if [ "$#" -eq 0 ]; then
    echo "Usage: androidsu <befehl>" >&2
    exit 2
fi

ID="$$_$(date +%s%N)"
REQ="$BRIDGE_DIR/req-$ID.txt"
RES="$BRIDGE_DIR/res-$ID.txt"

printf '%s\n' "$*" > "$REQ"

for i in $(seq 1 70); do
    [ -e "$RES" ] && break
    sleep 1
done

if [ ! -e "$RES" ]; then
    echo "androidsu: keine Antwort vom Root-Bridge-Wächter (Timeout, läuft er?)" >&2
    rm -f "$REQ"
    exit 124
fi

CODE="$(head -n 1 "$RES")"
tail -n +2 "$RES"
rm -f "$RES"
exit "${CODE:-1}"
